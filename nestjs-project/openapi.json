      "VideoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "example": "Kx7mQ2rTb9A",
            "description": "Unique public identifier"
          },
          "title": {
            "type": "string",
            "example": "My holiday clip"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ],
            "example": "ready"
          },
          "size_bytes": {
            "type": "number",
            "example": 42278,
            "description": "Size stored in object storage"
          },
          "mime_type": {
            "type": "string",
            "example": "video/mp4"
          },
          "original_filename": {
            "type": "string",
            "example": "holiday.mp4"
          },
          "duration_seconds": {
            "type": "object",
            "nullable": true,
            "example": 3,
            "description": "Filled by the worker once processing completes"
          },
          "metadata": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true,
            "description": "ffprobe-derived metadata; null until processing completes"
          },
          "processing_error": {
            "type": "object",
            "nullable": true,
            "description": "Reason recorded when processing ends in failure"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "status",
          "size_bytes",
          "mime_type",
          "original_filename",
          "created_at",
          "updated_at"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
